# Copy to .env and fill in. `.env` is git-ignored and loaded automatically by `vaxrag`.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Hugging Face token with access to the gated Gemma / MedGemma weights (GPU machine).
HF_TOKEN=
# Optional: API key configured on the vLLM server (`--api-key`).
VLLM_API_KEY=
